{
  "name": "elio",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:staff": "turbo run dev --filter=shell --filter=pay --filter=plans --filter=flow",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "verify:dentally-sync": "tsx scripts/verify-dentally-sync-infra.ts",
    "verify:plans-parity": "tsx scripts/verify-plans-parity.ts",
    "verify:pay-parity": "tsx scripts/verify-pay-parity.ts",
    "verify:flow-parity": "tsx scripts/verify-flow-parity.ts",
    "seed": "npm run seed --workspace=@elio/db",
    "pwa:assets": "npm run generate-assets --workspace=@elio/pwa",
    "postinstall": "prisma generate --schema packages/db/prisma/schema.prisma"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "npm@10.9.7",
  "dependencies": {
    "next": "^16.3.1"
  }
}
