model PlanModel {
  id                String   @id @default(cuid())
  practiceId        String
  practice          Practice @relation(fields: [practiceId], references: [id])
  name              String
  monthlyPricePence Int
  description       String?
  publicDescription String?

  // Plan rules (ElioPlans parity — Plan.requiresAdultMembership / dentistPayoutPerExam)
  requiresAdultMembership   Boolean @default(false)
  dentistPayoutPerExamPence Int?

  // Eligibility
  eligibilityDentalFit Boolean @default(false)

  // GoCardless pre-configured payment page URL
  gocardlessLink String?

  // Versioning (ElioPlans parity — Plan.version / parentPlanId / childVersions / isCurrentVersion)
  version          Int         @default(1)
  parentPlanId     String?
  parentPlan       PlanModel?  @relation("PlanModelVersions", fields: [parentPlanId], references: [id])
  childVersions    PlanModel[] @relation("PlanModelVersions")
  isCurrentVersion Boolean     @default(true)

  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planPatients          PlanPatient[]
  patientPlanEnrolments PatientPlanEnrolment[]
  inclusions            PlanInclusion[]
  discounts             PlanDiscount[]
  eligibilityRules      PlanEligibilityRule[]
  redeemRules           PlanRedeemRule[]

  @@index([practiceId])
  @@map("plans_plans")
}

model PlanInclusion {
  id          String             @id @default(cuid())
  practiceId  String
  practice    Practice           @relation(fields: [practiceId], references: [id])
  planId      String
  plan        PlanModel          @relation(fields: [planId], references: [id], onDelete: Cascade)
  name        String
  itemType    PlanRedeemItemType @default(OTHER)
  quantity    Int?
  period      String?
  description String?
  sortOrder   Int                @default(0)

  @@index([practiceId])
  @@map("plans_inclusions")
}

model PlanDiscount {
