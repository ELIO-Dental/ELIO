// Multi-tenant data model — Step 1.3 (Multi-Tenancy Foundations, FR-6).
// Contract: project-docs/DATA_MODEL.md — update that file in the same turn as any
// change here. See project-docs/00_SCOPE.md FR-6, NFR-2, NFR-3.
//
// COLLISION SAFETY: this Neon database is SHARED with the live ElioPlans production
// app, which already owns unmapped PascalCase tables (Patient, Payment, Plan, Mandate,
// Document, DocumentAcceptance, PatientPlan, User, Clinic, ...). Every model below is
// therefore @@map'd to a distinct snake_case table name — continuing the pattern Step
// 1.2 already established for `practices`/`users` — so nothing here can ever collide
// with or overwrite ElioPlans' live rows.
//
// Tenant isolation: enforced via a shared Prisma Client Extension query-wrapper
// in packages/db/tenant.ts (NOT PostgreSQL RLS) — see
// elio/docs/adr/0001-tenant-isolation-strategy.md for the decision record and why
// RLS was rejected for this stage (Neon pooler transaction-mode + Prisma session
// variable propagation risk).

generator client {
  provider = "prisma-client-js"
  // Deliberately NOT a custom `output` path (was "../generated/client").
  // Found live (2026-08-28), a two-part bug chased through several rounds
  // of real deployment testing: (1) missing binaryTargets meant only the
  // Windows engine got bundled at all — fixed by adding "rhel-openssl-3.0.x"
  // below. (2) even after that, and even after confirming via a live debug
  // route that the correct .so.node file WAS present in the deployed
  // function's filesystem, every real query still crashed with the same
  // "could not locate the Query Engine" error — because Prisma's generated
  // client resolves its own engine path relative to where NEXT.JS'S BUNDLER
  // physically placed the compiled chunk at build time, which does NOT
  // match the original packages/db/generated/client/ location once a
  // custom `output` path gets bundled by Turbopack/webpack. The DEFAULT
  // output location (node_modules/.prisma/client) has real, tested,
  // Prisma-documented special-case support in Next.js's own file tracer for
  // exactly this reason — every other combination silently breaks under a
  // bundler. binaryTargets below still applies at the default location too.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Non-pooled Neon connection, used ONLY for migrations (see PERFORMANCE_SCALABILITY.md
  // section 2). Prisma Migrate reads `directUrl` for schema changes when set, while the
  // app always uses the pooled `url` above for normal queries. Set 2026-08-17 to the
  // real non-pooled host (same DB as `url` above, just without "-pooler" — confirmed
  // via `prisma migrate status` resolving against the correct direct host).
  directUrl = env("DIRECT_DATABASE_URL")
}

