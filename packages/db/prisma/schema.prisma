// ============================================================================
// CORE SHARED MODELS (packages/db, read by every module)
// ============================================================================

model Practice {
  id                    String  @id @default(cuid())
  name                  String
  requireMfaForAllStaff Boolean @default(false)

  // Super Admin Control Centre fields (FR-10) — set/read by apps/admin, Phase 2.
  dentallyApiKey           String? // encrypted at rest, Phase 2 — see ENGINEERING_CONVENTIONS.md
  dentallyConnectionStatus DentallyConnectionStatus @default(NOT_CONNECTED)
  plan                     String? // data label only, e.g. "Trial"/"Enterprise" — not a billing system
  trialEndsAt              DateTime?
  onboardingStatus         OnboardingStatus         @default(NOT_STARTED)
  supportStatus            String?
  suspendedAt              DateTime? // a suspended practice's users can't log in

  // General per-practice custom domain mechanism (kept open per 00_SCOPE.md section 9 /
  // open question 11) — only Aura's own Practice row uses this in Phase 1/2.
  customDomain String? @unique

  // ElioPay §6.3: Dentally has no fixed system vocabulary for "cosmetic
  // consultation" — treatment_category_id resolves to practice-defined names.
  // This is a genuinely external unknown (see project-docs/PROJECT_STATE.md),
  // so it's a manual/admin-settable value, not a hardcoded guess. Matched
  // case-insensitively against Treatment.dentallyTreatmentCategory when set.
  cosmeticConsultationTreatmentCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  auditLogs             AuditLog[]
  licences              Licence[]
  featureFlags          PracticeFeatureFlag[]
  impersonationSessions ImpersonationSession[]
  dentallySyncRuns      DentallySyncRun[]

  // Dentally-synced core (Step 1.4 owns the sync job; draft shape only here)
  patients     Patient[]
  appointments Appointment[]
  treatments   Treatment[]
  invoices     Invoice[]

  // ElioPay (draft)
  dentists               Dentist[]
  payPeriods             PayPeriod[]
  compassStatements      CompassStatement[]
  payslipEntries         PayslipEntry[]
  supplierInvoiceEntries SupplierInvoiceEntry[]
  savedLabs              SavedLab[]
  savedSuppliers         SavedSupplier[]
  legacyPayslipArchives  LegacyPayslipArchive[]

  // ElioPlans (draft)
  plansPlans           PlanModel[]
  planPatients         PlanPatient[]
  planInclusions       PlanInclusion[]
  planDiscounts        PlanDiscount[]
  planEligibilityRules PlanEligibilityRule[]
  planRedeemRules      PlanRedeemRule[]
  planRedeems          PlanRedeem[]
  planDocuments        PlanDocument[]
  planSigningRequests  PlanSigningRequest[]
  planGuideArticles    PlanGuideArticle[]

  // ElioFlow (draft)
  enquiries                    Enquiry[]
  consults                     Consult[]
  reminders                    Reminder[]
  legacyFlowTouchPointArchives LegacyFlowTouchPointArchive[]
  patientPlanEnrolments        PatientPlanEnrolment[]
  planPayments                 PlanPayment[]
  planMandates                 PlanMandate[]

  @@map("practices")
}

model User {
  id             String  @id @default(cuid())
  email          String  @unique
  hashedPassword String
  role           Role    @default(STAFF)
  active         Boolean @default(true)

  mfaSecret  String?
  mfaEnabled Boolean @default(false)

  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])

  passwordResetTokens PasswordResetToken[]
  auditLogsAsActor    AuditLog[]           @relation("AuditLogActor")
  planRedeemApprovals PlanRedeem[]         @relation("PlanRedeemApprovedBy")
  enquiriesCaptured   Enquiry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([practiceId])
  @@map("users")
}

// Self-serve password reset — single-use, 1-hour expiry tokens (hashed at rest).
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// Written by FR-4 (permission changes), FR-10 (super-admin actions), impersonation
// sessions. practiceId is nullable because super-admin actions (Step 2.3) aren't
// scoped to a single practice.
model AuditLog {
  id                 String    @id @default(cuid())
  practiceId         String?
  practice           Practice? @relation(fields: [practiceId], references: [id])
  actorUserId        String
  actor              User      @relation("AuditLogActor", fields: [actorUserId], references: [id])
  impersonatedUserId String? // set only during an impersonation session
  action             String
  targetType         String
  targetId           String
  metadata           Json?
  createdAt          DateTime  @default(now())

  @@index([practiceId])
  @@map("audit_logs")
}

// Phase 2, Step 2.1/2.2 — per-module licence + per-module trial clock.
model Licence {
  id          String    @id @default(cuid())
  practiceId  String
  practice    Practice  @relation(fields: [practiceId], references: [id])
  moduleId    ModuleId
  active      Boolean   @default(false)
  grantedAt   DateTime?
  revokedAt   DateTime?
  trialEndsAt DateTime?

  @@unique([practiceId, moduleId])
  @@index([practiceId])
  @@map("licences")
}

// Phase 2, Step 2.3 — per-tenant feature flags set by the Super Admin.
model FeatureFlag {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?

  practiceFlags PracticeFeatureFlag[]

  @@map("feature_flags")
}

model PracticeFeatureFlag {
  id            String      @id @default(cuid())
  practiceId    String
  practice      Practice    @relation(fields: [practiceId], references: [id])
  featureFlagId String
  featureFlag   FeatureFlag @relation(fields: [featureFlagId], references: [id])
  enabled       Boolean     @default(false)

  @@unique([practiceId, featureFlagId])
  @@index([practiceId])
  @@map("practice_feature_flags")
}

// Phase 2, Step 2.3 — audit trail for FR-10's impersonation/support mode.
model ImpersonationSession {
  id                 String    @id @default(cuid())
  superAdminUserId   String
  impersonatedUserId String
  practiceId         String
  practice           Practice  @relation(fields: [practiceId], references: [id])
  startedAt          DateTime  @default(now())
  endedAt            DateTime?
  reason             String?

  @@index([practiceId])
  @@map("impersonation_sessions")
}

model DentallySyncRun {
  id           String                @id @default(cuid())
  practiceId   String
  practice     Practice              @relation(fields: [practiceId], references: [id])
  trigger      DentallySyncTrigger
  status       DentallySyncRunStatus   @default(RUNNING)
  startedAt    DateTime              @default(now())
  finishedAt   DateTime?
  counts       Json?
  errorMessage String?
  recordErrors Json?

  @@index([practiceId, startedAt])
  @@map("dentally_sync_runs")
}

// ============================================================================
// DENTALLY-SYNCED CORE (Step 1.4, read-only for modules) — draft shape
// ============================================================================

model Patient {
  id          String    @id @default(cuid())
  practiceId  String
  practice    Practice  @relation(fields: [practiceId], references: [id])
  dentallyId  String
  firstName   String?
  lastName    String?
  dateOfBirth DateTime?
  email       String?
  phone       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]
  treatments   Treatment[]
  invoices     Invoice[]
  planPatients PlanPatient[]
  enquiries    Enquiry[]

  @@unique([practiceId, dentallyId])
  @@index([practiceId])
  @@map("dentally_patients")
}

model Appointment {
  id             String    @id @default(cuid())
  practiceId     String
  practice       Practice  @relation(fields: [practiceId], references: [id])
  dentallyId     String
  patientId      String?
  patient        Patient?  @relation(fields: [patientId], references: [id])
  startsAt       DateTime?
  endsAt         DateTime?
  // Dentally's raw `state`/`reason`/`practitioner_id` fields were already
  // captured in DentallyAppointmentRaw (packages/dentally/src/types.ts) but
  // never normalized/stored — added for Step 1.8 (ElioFlow), which needs
  // `reason` to identify "Cosmetic Consultation" appointments (the old
  // standalone ElioFlow app's entire dataset was Dentally appointments
  // filtered by this exact field) and `dentallyState`/`practitionerId` for
  // attendance/attribution. Nullable and additive — existing synced rows
  // simply have these as null until the next sync run populates them.
  dentallyState  String?
  reason         String?
  practitionerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consults Consult[]

  @@unique([practiceId, dentallyId])
  @@index([practiceId])
  @@map("dentally_appointments")
}

model Treatment {
  id          String    @id @default(cuid())
  practiceId  String
  practice    Practice  @relation(fields: [practiceId], references: [id])
  dentallyId  String
  patientId   String?
  patient     Patient?  @relation(fields: [patientId], references: [id])
  completedAt DateTime?
  amountPence Int?

  // ElioPay §6.3 attribution: raw Dentally practitioner id from
  // invoice_item.practitioner_id (source of truth), resolved to a Dentist
  // row when one with a matching dentallyPractitionerId exists.
  dentallyPractitionerId String?
  dentistId              String?
  dentist                Dentist? @relation(fields: [dentistId], references: [id])

  // Dentally's treatment_category_id resolved name, if the sync captured
  // one — no fixed system vocabulary exists (practice-defined names), so
  // this is matched against Practice.cosmeticConsultationTreatmentCode
  // as a configurable value rather than a hardcoded string/guess.
  dentallyTreatmentCategory String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  privateRevenueLineItems PrivateRevenueLineItem[]

  @@unique([practiceId, dentallyId])
  @@index([practiceId])
  @@index([dentistId])
  @@map("dentally_treatments")
}

model Invoice {
  id         String   @id @default(cuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])
  dentallyId String
  patientId  String?
  patient    Patient? @relation(fields: [patientId], references: [id])
  totalPence Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([practiceId, dentallyId])
  @@index([practiceId])
  @@map("dentally_invoices")
}

// ============================================================================
// ELIOPAY (draft — Step 1.6 builds full business logic; adapted from
// ElioPlans/prisma/schema.prisma's shape where relevant, per DATA_MODEL.md section 3)
// ============================================================================

model Dentist {
  id                     String   @id @default(cuid())
  practiceId             String
  practice               Practice @relation(fields: [practiceId], references: [id])
  userId                 String? // nullable — a clinician may not have their own ELIO login
  name                   String
  nhsPerformerNumber     String?
  // Dentally's own numeric practitioner id (invoice_item.practitioner_id) —
  // real, structured attribution of a treatment to the dentist who performed
  // it, distinct from nhsPerformerNumber (used for Compass matching only).
  dentallyPractitionerId String?
  payType                PayType

  // PERCENTAGE_SPLIT (dentists)
  privateSplitPercent Decimal? @db.Decimal(5, 2)
  udaRatePence        Int?

  // HOURLY (therapists/hygienists)
  hourlyRatePence Int?

  effectiveFrom DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hourEntries           HourEntry[]
  compassStatementLines PayLine[]
  payslipEntries        PayslipEntry[]
  labBillEntries        LabBillEntry[]
  treatments            Treatment[]
  consults              Consult[]

  @@index([practiceId])
  @@index([practiceId, dentallyPractitionerId])
  @@map("pay_dentists")
}

model HourEntry {
  id           String          @id @default(cuid())
  dentistId    String
  dentist      Dentist         @relation(fields: [dentistId], references: [id])
  payPeriodId  String
  payPeriod    PayPeriod       @relation(fields: [payPeriodId], references: [id])
  hours        Decimal         @db.Decimal(6, 2)
  source       HourEntrySource @default(DENTALLY)
  enteredBy    String?
  overriddenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dentistId])
  @@index([payPeriodId])
  @@map("pay_hour_entries")
}

model PayPeriod {
  id          String          @id @default(cuid())
  practiceId  String
  practice    Practice        @relation(fields: [practiceId], references: [id])
  periodStart DateTime // inclusive, Europe/London calendar-month start
  periodEnd   DateTime // exclusive (half-open interval, BUG-2 fix)
  status      PayPeriodStatus @default(DRAFT)
  lockedAt    DateTime?
  triggeredAt DateTime? // the 15th run date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hourEntries       HourEntry[]
  compassStatements CompassStatement[]
  payslipEntries    PayslipEntry[]

  @@index([practiceId])
  @@index([periodStart])
  @@index([periodEnd])
  @@map("pay_periods")
}

model CompassStatement {
  id                  String                 @id @default(cuid())
  practiceId          String
  practice            Practice               @relation(fields: [practiceId], references: [id])
  payPeriodId         String
  payPeriod           PayPeriod              @relation(fields: [payPeriodId], references: [id])
  fileUrl             String
  contractNumber      String?
  statementReference  String?
  statementDate       DateTime?
  activityPeriodStart DateTime? // display/audit only — never gates the private-earnings calc
  activityPeriodEnd   DateTime?
  uploadedAt          DateTime               @default(now())
  parsedAt            DateTime?
  status              CompassStatementStatus @default(PENDING)

  lines PayLine[] @relation("CompassStatementLines")

  @@index([practiceId])
  @@index([payPeriodId])
  @@map("pay_compass_statements")
}

// Named PayLine (not CompassStatementLine) at the table level to avoid any future
// ambiguity with the model name in generated types — table itself stays descriptive.
model PayLine {
  id                  String           @id @default(cuid())
  compassStatementId  String
  compassStatement    CompassStatement @relation("CompassStatementLines", fields: [compassStatementId], references: [id])
  dentistId           String?
  dentist             Dentist?         @relation(fields: [dentistId], references: [id])
  performerNumber     String?
  rawDentistName      String?
  udas                Decimal?         @db.Decimal(8, 2)
  superannuationPence Int?
  matchConfidence     MatchConfidence  @default(NEEDS_REVIEW)
  reviewedBy          String?
  reviewedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([compassStatementId])
  @@index([dentistId])
  @@map("pay_compass_statement_lines")
}

model PayslipEntry {
  id          String    @id @default(cuid())
  practiceId  String
  practice    Practice  @relation(fields: [practiceId], references: [id])
  payPeriodId String
  payPeriod   PayPeriod @relation(fields: [payPeriodId], references: [id])
  dentistId   String
  dentist     Dentist   @relation(fields: [dentistId], references: [id])
  payType     PayType

  // PERCENTAGE_SPLIT
  udas                        Decimal? @db.Decimal(8, 2)
  udaRatePence                Int?
  nhsEarningsPence            Int?
  grossPrivateRevenuePence    Int?
  privateSplitPercent         Decimal? @db.Decimal(5, 2)
  privateEarningsPence        Int?
  consultationExclusionsPence Int?
  labDeductionPence           Int?
  superannuationPence         Int?

  // HOURLY
  hoursWorked         Decimal? @db.Decimal(6, 2)
  hourlyRatePence     Int?
  hourlyEarningsPence Int?

  // Both
  manualAdjustmentsPence Int     @default(0)
  adjustmentReason       String?
  finalPayPence          Int?
  pdfUrl                 String?

  // Y1.5–Y1.6 — AuraPay Dentally fetch snapshot (legacy private_patients_json / analytics_json / therapy_*)
  dentallyPatientsJson      Json?
  dentallyAnalyticsJson     Json?
  dentallyTherapyJson       Json?
  dentallyDiscrepanciesJson Json?
  therapyMinutes            Decimal? @db.Decimal(8, 2)
  therapyRatePerMinute      Decimal? @db.Decimal(10, 4) // legacy AuraPay therapy_rate (£/min)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  privateRevenueLineItems PrivateRevenueLineItem[]

  // F.1 Final QA money-path audit (2026-08-29): apps/pay/lib/pay-service.ts's
  // calculatePayslipForDentist() and the /api/pay-periods/[id]/calculate
  // route both used a find-then-write pattern with no DB-level guard —
  // explicitly flagged inline in the route's own comment ("No natural unique
  // key on (payPeriodId, dentistId) in the schema — find-then-write") as a
  // known gap. Two concurrent calculate requests for the same dentist/period
  // (a real scenario: a double-click, or a retried request after a slow
  // response) could both read `existing` as null and both CREATE, producing
  // two PayslipEntry rows instead of one update — a real duplicate-payslip
  // risk under retry, exactly what BUG-1/NFR-1 forbid for a money path.
  // Closing the gap at the schema level (not just adding a mutex in code)
  // matches PlanPayment's own idempotency pattern.
  @@unique([payPeriodId, dentistId])
  @@index([practiceId])
  @@index([payPeriodId])
  @@index([dentistId])
  @@map("pay_payslip_entries")
}

/**
 * Step 1.9 (MASTER_BUILD_GUIDE.md §1.9): a verbatim, read-only archive of a
 * pre-migration payslip from the old standalone ElioPay ("aurapay") system.
 * The old system stored each payslip as one denormalized row with several
 * JSON blobs (itemized private-patient payments with real invoice/patient
 * ids, discrepancy notes, computed analytics) — see
 * `scripts/migrations/migrate-elioay.ts`'s header comment for the full old
 * shape. The new `PayslipEntry`/`PrivateRevenueLineItem` models are
 * intentionally normalized and expect every private-revenue line to
 * reference a real, Dentally-synced `Treatment` row — the old JSON's loose
 * patient-name/invoice-id records don't safely auto-match onto that without
 * real cross-referencing against synced Dentally data, which risks
 * silently mis-attributing real payroll figures if done wrong. Rather than
 * force a risky, unverified transformation of real historical pay data,
 * this model preserves the old row EXACTLY as it was (satisfying the
 * guide's "historical records remain traceable" requirement) without ever
 * feeding it into the new system's live payroll calculations. A human can
 * open a specific archived payslip for reference/audit at any time; if a
 * later, carefully-verified pass wants to properly re-derive
 * `PrivateRevenueLineItem` rows from this archive (matching against synced
 * Treatments), that's a deliberate, separate, reviewed piece of work — not
 * something this migration silently attempts.
 */
model LegacyPayslipArchive {
  id          String   @id @default(cuid())
  practiceId  String
  practice    Practice @relation(fields: [practiceId], references: [id])
  // The old system's own numeric row id — kept as a plain string (not a
  // foreign key into anything) purely for traceability back to the source.
  sourceId    String
  dentistName String
  periodMonth Int
  periodYear  Int
  rawRowJson  String // the ENTIRE old payslip_entries row, verbatim, as JSON text
  migratedAt  DateTime @default(now())

  @@unique([practiceId, sourceId])
  @@index([practiceId])
  @@map("pay_legacy_payslip_archive")
}

model PrivateRevenueLineItem {
  id                     String       @id @default(cuid())
  payslipEntryId         String
  payslipEntry           PayslipEntry @relation(fields: [payslipEntryId], references: [id])
  treatmentId            String?
  treatment              Treatment?   @relation(fields: [treatmentId], references: [id])
  amountPence            Int
  excludedAsConsultation Boolean      @default(false)

  // Y1 — patient-row metadata from Dentally fetch (AuraPay private_patients_json fields)
  patientName              String?
  invoiceDate              String? // YYYY-MM-DD
  dentallyInvoiceId        String?
  dentallyPatientId        String?
  durationMins             Int?
  isFinance                Boolean @default(false)
  paymentStatus            String? // paid | partial | unpaid
  amountPaidPence          Int?
  amountOutstandingPence   Int?
  treatmentDescription     String?
  hourlyRatePence          Int?
  flagged                  Boolean @default(false)
  flagReason               String?
  financeFeePence          Int? // AuraPay financeFee on patient row; Tabeo rates applied in Y3.5 settings

  createdAt DateTime @default(now())

  @@index([payslipEntryId])
  @@map("pay_private_revenue_line_items")
}

model LabBillEntry {
  id          String   @id @default(cuid())
  practiceId  String
  dentistId   String?
  dentist     Dentist? @relation(fields: [dentistId], references: [id])
  amountPence Int
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([practiceId])
  @@index([dentistId])
  @@map("pay_lab_bill_entries")
}

model SupplierInvoiceEntry {
  id          String         @id @default(cuid())
  practiceId  String
