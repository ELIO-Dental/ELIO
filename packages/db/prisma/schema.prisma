// ============================================================================
// ELIOFLOW (draft — Step 1.8 builds full business logic)
// ============================================================================

// Old ElioFlow's Pipeline sheet tracked "touch points" as a single incrementing
// counter with no per-contact date — the new Reminder model requires a real
// dueAt/sentAt per row, so fabricating N synthetic dated Reminder rows from a
// bare count would invent history that never existed. Preserves the whole old
// pipeline row verbatim instead (Step 1.9 ElioFlow migration), mirroring
// LegacyPayslipArchive's pattern above.
model LegacyFlowTouchPointArchive {
  id              String   @id @default(cuid())
  practiceId      String
  practice        Practice @relation(fields: [practiceId], references: [id])
  // Old Sheets "Patient ID" column — the Dentally patient id, kept as plain
  // text (not an FK) purely for traceability back to the source row.
  sourcePatientId String
  touchPoints     Int
  rawRowJson      String // the ENTIRE old Pipeline sheet row, verbatim, as JSON text
  migratedAt      DateTime @default(now())

  @@unique([practiceId, sourcePatientId])
  @@index([practiceId])
  @@map("flow_legacy_touch_point_archive")
}

model Enquiry {
  id               String   @id @default(cuid())
  practiceId       String
  practice         Practice @relation(fields: [practiceId], references: [id])
  patientId        String? // nullable until linked to a Dentally record
  patient          Patient? @relation(fields: [patientId], references: [id])
  // Free text, not an enum — Step 1.8 research found no fixed vocabulary
  // anywhere in the old ElioFlow app or the spec docs (open item, see
  // DATA_MODEL.md §5's 2026-08-19 change-log entry). Practices can type
  // whatever they actually use ("walk-in", "phone", "website form", ...).
  source           String?
  capturedAt       DateTime @default(now())
  capturedByUserId String? // staff attribution — who logged this enquiry
  capturedByUser   User?    @relation(fields: [capturedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consults Consult[]

  @@index([practiceId])
  @@map("flow_enquiries")
}

model Consult {
  id                    String              @id @default(cuid())
  practiceId            String
  practice              Practice            @relation(fields: [practiceId], references: [id])
  enquiryId             String
  enquiry               Enquiry             @relation(fields: [enquiryId], references: [id])
  // Links this consult to the real Dentally-synced appointment it came from
  // (the old ElioFlow app's entire dataset WAS Dentally "Cosmetic
  // Consultation" appointments — without this link, ElioFlow can't read
  // Dentally-sourced consult facts without a duplicate sync of its own).
  appointmentId         String?
  appointment           Appointment?        @relation(fields: [appointmentId], references: [id])
  attended              Boolean? // old ElioFlow: attended 'true'/'false' string
  // Old ElioFlow: `practitioner` was a free-text string matched against a
  // Sheets-based UserRow.dentistName. The shared core already has a real
  // Dentist model (ElioPay owns it) — reference it instead of duplicating
  // a name string, so "conversion rate by dentist" reporting (§8) is a
  // real join, not string matching.
  practitionerDentistId String?
  practitionerDentist   Dentist?            @relation(fields: [practitionerDentistId], references: [id])
  quotePence            Int?
  // Manual override of quotePence, e.g. a discount agreed verbally — old
  // ElioFlow's `planValueOverride` semantics: once set, sync/re-derivation
  // must never silently clobber it.
  quotePenceOverride    Int?
  // Read-only mirror of Dentally payment totals for this patient's account,
  // synced the same way the old app's `totalPaid` was — NOT an ElioFlow-owned
  // source of truth, just a convenience field for the pipeline/reporting UI.
  totalPaidPence        Int?
  hasDeposit            Boolean? // old ElioFlow: hasDeposit
  treatmentBooked       Boolean? // old ElioFlow: treatmentBooked
  outcome               ConsultOutcome?
  outcomeAt             DateTime?
  // Sub-reason for a THINKING/DECLINED outcome. Old ElioFlow tracked WHY a
  // lead is stuck (failed-finance/price-shopping/bad-experience/out-of-budget)
  // as real business value staff used for reporting — the new 3-value
  // ConsultOutcome enum alone loses that granularity, so this restores it
  // as an optional field rather than dropping it (open item, see
  // DATA_MODEL.md §5's 2026-08-19 change-log entry).
  stuckReason           ConsultStuckReason?
  // Local denormalized flag: has this patient signed up to a membership
  // plan (old ElioFlow: `elioCare`, a manual boolean directly on the
  // pipeline row). The actual signup happens in ElioPlans via the
  // Accepted-outcome UI handoff (APPLICATION_FLOW.md §12 — never a
  // cross-module DB write); this flag is set by that same UI action so
  // ElioFlow's own funnel/conversion reporting doesn't need to query
  // ElioPlans data, which modules should not do across boundaries.
  planSignedUp          Boolean             @default(false)
  notes                 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reminders Reminder[]

  @@index([practiceId])
  @@map("flow_consults")
}

// Old ElioFlow's 4 real "why stuck" values (STATUS_OPTIONS in pages/index.tsx),
// confirmed via Step 1.8 codebase research — excludes 'new'/'thinking'/
// 'converted'/'completed', which map onto ConsultOutcome/outcomeAt instead.
enum ConsultStuckReason {
  FAILED_FINANCE
  PRICE_SHOPPING
  BAD_EXPERIENCE
  OUT_OF_BUDGET
}

model Reminder {
  id         String    @id @default(cuid())
  practiceId String
  practice   Practice  @relation(fields: [practiceId], references: [id])
  consultId  String
  consult    Consult   @relation(fields: [consultId], references: [id])
  dueAt      DateTime
  sentAt     DateTime?
  // Free text, not an enum — no fixed channel vocabulary specified anywhere
  // (open item, see DATA_MODEL.md §5's 2026-08-19 change-log entry). Also
  // doubles as old ElioFlow's `touchPoints` counter: rather than a manual,
  // easy-to-forget increment button, "touch points" for a consult is now
  // COUNT(Reminder WHERE consultId = X AND sentAt IS NOT NULL) — every
  // contact is a real, timestamped record instead of a number staff must
  // remember to bump.
  channel    String?

  createdAt DateTime @default(now())

  @@index([practiceId])
  @@map("flow_reminders")
}
