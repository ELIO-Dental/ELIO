// GoCardless webhook replay guard (Step 1.7). Global (not practice-scoped) —
// the GoCardless event id itself is globally unique and the webhook body
// carries no practiceId, so tenant is resolved AFTER this dedup check by
// looking up the mandate/payment the event references. The unique primary
// key `id` (the GoCardless event id) is what idempotentCreate() from
// packages/plans-engine relies on: a replayed event fails with P2002 and is
// then read back and skipped instead of being reprocessed.
model PlanWebhookEvent {
  id           String   @id
  resourceType String
  action       String
  createdAt    DateTime @default(now())

  @@map("plans_webhook_events")
}

// BUG-1 fix at the database level: @@unique([patientPlanEnrolmentId, billingPeriod])
// MUST survive every future migration that touches this table — see
// project-docs/DATA_MODEL.md section 4.
model PlanPayment {
  id                     String                @id @default(cuid())
  practiceId             String
  practice               Practice              @relation(fields: [practiceId], references: [id])
  planPatientId          String
  planPatient            PlanPatient           @relation(fields: [planPatientId], references: [id])
  patientPlanEnrolmentId String?
  patientPlanEnrolment   PatientPlanEnrolment? @relation(fields: [patientPlanEnrolmentId], references: [id])
  mandateId              String?
  mandate                PlanMandate?          @relation(fields: [mandateId], references: [id])
  billingPeriod          String? // "YYYY-MM" in Europe/London; null for ad-hoc/legacy charges
  gocardlessPaymentId    String?               @unique
  amountPence            Int
  status                 PlanPaymentStatus     @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([patientPlanEnrolmentId, billingPeriod])
  @@index([practiceId])
  @@map("plans_payments")
}

model PlanDocument {
